# Leave empty when Vite proxies the API during local development.
VITE_API_BASE_URL=

# Cesium Moon terrain (ion asset 2684829). Use a project token with access to
# this asset for deployment. Empty falls back to the NASA reference globe.
# Browser-visible token: grant only read access and restrict allowed URLs.
# Production can instead set CESIUM_PUBLIC_ION_TOKEN on the backend; the viewer
# reads /api/viewer-config at runtime, without baking the token into the image.
VITE_CESIUM_ION_ACCESS_TOKEN=
