# Leave empty when Vite proxies the API during local development.
VITE_API_BASE_URL=

# Cesium Moon terrain (ion asset 2684829). Use a project token with access to
# this asset for deployment. Empty uses CesiumJS's temporary evaluation token.
# Browser-visible token: grant only read access and restrict allowed URLs.
VITE_CESIUM_ION_ACCESS_TOKEN=
