# Ensure LF line endings for text files, especially SPICE text kernels
* text=auto eol=lf

# Explicit binary files
*.glb binary
*.gltf binary
*.blend binary
*.bsp binary
*.bpc binary
*.png binary
*.jpg binary
*.webp binary
*.ico binary

# SPICE text kernels requiring strict sha256 byte parity
backend/kernels/*.tls text eol=lf
backend/kernels/*.tpc text eol=lf
backend/kernels/*.tf text eol=lf
